# Salin menjadi backend/.env. Jangan commit .env atau kredensial asli.
# PostgreSQL 15+; URL-encode karakter khusus password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/pnl_obe
# Buat dengan: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]

# Hanya seed awal. Password 12–72 byte UTF-8, tanpa default bawaan.
SEED_PRODI_KODE=TI
SEED_PRODI_NAMA=Teknik Informatika
SEED_PRODI_JENJANG=D4
SEED_ADMIN_NAMA=Administrator Teknik Informatika
SEED_ADMIN_NIM_NIDN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Wajib hanya bila menjalankan seed --demo:
SEED_DOSEN_NAMA=Contoh Dosen
SEED_DOSEN_NIM_NIDN=
SEED_DOSEN_EMAIL=
SEED_DOSEN_PASSWORD=
SEED_MAHASISWA_NAMA=Contoh Mahasiswa
SEED_MAHASISWA_NIM_NIDN=
SEED_MAHASISWA_EMAIL=
SEED_MAHASISWA_PASSWORD=
SEED_ANGKATAN=2026

# Hanya bila memakai Docker Compose; samakan dengan DATABASE_URL di atas.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=pnl_obe
POSTGRES_PORT=5432
